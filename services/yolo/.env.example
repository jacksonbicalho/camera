# Copie para .env e ajuste os caminhos para o storage/models da instância
# de câmera que este serviço YOLO vai atender. O YOLO precisa enxergar o
# MESMO diretório de storage que a câmera usa (Storage.Path) — os paths de
# arquivo trocados via API (/classify, /analyze, /finetune) são resolvidos
# dentro do container do YOLO a partir desse volume.
YOLO_STORAGE_PATH=./storage
YOLO_MODELS_PATH=./models
