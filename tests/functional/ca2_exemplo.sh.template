#!/bin/sh
# Template de cenário funcional — copie para tests/functional/caNN_<slug>.sh
# e adapte. Contrato: exit 0 = critério de aceite atendido; qualquer outra
# coisa = reprovado. Escrito pelo driver ANTES do gate G2 (o navigator revisa
# o cenário junto com a story). Enquanto o código não existe, o cenário deve
# FALHAR com mensagem clara — nunca quebrar por erro de sintaxe.
#
# Padrões úteis:
#   - API HTTP:   subir o binário em porta efêmera, curl, validar JSON com jq
#   - Backend:    go test -count=1 -run 'TestFunctional_CA2' ./internal/...
#   - Frontend:   (cd frontend && yarn test --run --testNamePattern 'CA2')
#
# Exemplo (critério: "GET /api/cameras retorna 200 com lista JSON"):

set -eu
cd "$(git rev-parse --show-toplevel)"

PORT=18081
go build -o /tmp/camera-functional ./cmd/camera 2>/dev/null || {
  echo "CA2 FALHOU: build do binário falhou"; exit 1;
}
/tmp/camera-functional --port "$PORT" & PID=$!
trap 'kill "$PID" 2>/dev/null || true' EXIT
sleep 1

status=$(curl -s -o /tmp/ca2_body.json -w '%{http_code}' "http://localhost:$PORT/api/cameras")
[ "$status" = "200" ] || { echo "CA2 FALHOU: esperava 200, veio $status"; exit 1; }
jq -e 'type == "array"' /tmp/ca2_body.json >/dev/null || {
  echo "CA2 FALHOU: corpo não é um array JSON"; exit 1;
}
echo "CA2 OK"
