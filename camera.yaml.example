# camera.yaml — arquivo de bootstrap mínimo
# Câmeras, motion e zonas de exclusão são gerenciados via UI/API (banco de dados).
# Este arquivo só precisa existir para o sistema iniciar pela primeira vez.

debug: false                      # env: OS_CAMERA_DEBUG
timezone: America/Sao_Paulo       # env: OS_CAMERA_TIMEZONE — fuso horário da instalação (padrão: UTC)

db_path: /var/camera/data/camera.db  # caminho do banco SQLite (criado automaticamente)

log:
  output: stdout                   # stdout | file
  path:                            # diretório quando output: file
  # Rotação de arquivos (somente output: file). Valores abaixo são os defaults
  # aplicados quando os campos estão ausentes:
  # max_size_mb: 50                 # rotaciona o arquivo ao atingir este tamanho (MB)
  # max_age_days: 30               # apaga rotacionados mais velhos que isto (0 = ilimitado)
  # max_backups: 10                # máx. de arquivos rotacionados por nível (0 = ilimitado)
  # compress: true                 # comprime os rotacionados em gzip

server:
  port: 8080
  segments_path: /var/camera/data/hls  # diretório para segmentos HLS do streaming ao vivo
  # Configurações HLS (latência e DVR) são definidas por câmera via UI.
  # Padrões: 2 s por segmento, janela de 5 segmentos (~10 s de latência), DVR desativado.
  jwt_secret: ""                   # env: OS_CAMERA_JWT_SECRET — vazio = gerado aleatoriamente a cada boot

storage:
  path: /var/camera/data/recordings   # diretório de gravações — env: OS_CAMERA_STORAGE_PATH
  # retenção, tamanho máximo e intervalo de limpeza são configurados via /settings/storage na UI
  # e armazenados no banco de dados — nunca neste arquivo

# smtp:                             # opcional — servidor de e-mail (usado pela recuperação de senha)
#   host: smtp.example.com          # env: OS_CAMERA_SMTP_HOST
#   port: 587                       # env: OS_CAMERA_SMTP_PORT
#   username: no-reply@example.com  # env: OS_CAMERA_SMTP_USERNAME
#   password: ""                    # env: OS_CAMERA_SMTP_PASSWORD
#   from_name: "os-camera"          # opcional — nome de exibição do remetente; env: OS_CAMERA_SMTP_FROM_NAME
#   from_email: ""                  # opcional — e-mail do remetente/envelope; default = username; env: OS_CAMERA_SMTP_FROM_EMAIL

admin:
  username: admin                  # usuário administrador criado na primeira inicialização
  password: changeme               # senha inicial — troca obrigatória no primeiro login
