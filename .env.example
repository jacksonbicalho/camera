# .env — variáveis de ambiente locais (gitignored). Copie para .env e preencha.
# Todas seguem o prefixo OS_CAMERA_ — sobrescrevem os campos correspondentes
# de camera.yaml quando presentes (vazio = não sobrescreve). Ver docs/configuration.md.

# SMTP — servidor de e-mail (config only; ainda sem cliente SMTP/envio implementado)
OS_CAMERA_SMTP_HOST=
OS_CAMERA_SMTP_PORT=
OS_CAMERA_SMTP_USERNAME=
OS_CAMERA_SMTP_PASSWORD=

# JWT — segredo fixo (vazio = gerado aleatoriamente a cada boot)
OS_CAMERA_JWT_SECRET=

# Timezone — fuso da instalação (padrão: UTC)
OS_CAMERA_TIMEZONE=

# Debug — ativa logs de nível debug
OS_CAMERA_DEBUG=

# Storage — diretório raiz das gravações
OS_CAMERA_STORAGE_PATH=
