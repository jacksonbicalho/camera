# Copie para .env pra sobrescrever a config do harness e2e sem editar o repo —
# scripts/e2e.sh/docker compose lê este arquivo automaticamente (e2e/ é o
# project-directory do compose). Todas opcionais; sem .env, os defaults abaixo
# já são os valores usados hoje.

# Ids/credenciais do fixture semeado (e2e/seed/main.go) — normalmente não há
# motivo pra mudar, já que os specs (e2e/tests/*.spec.ts) esperam esses
# valores exatos como fallback; existe aqui pra manter uma única forma de
# configurar o harness (mesma sintaxe ${VAR:-default} usada pelas opções do
# Playwright abaixo).
E2E_ADMIN_USER=admin
E2E_ADMIN_PASS=e2e-password-123
E2E_CAMERA_ID=e2e00000-0000-4000-8000-000000000001
E2E_ADMIN_ONLY_CAMERA_ID=e2e00000-0000-4000-8000-000000000002
E2E_VIEWER_USER=viewer
E2E_VIEWER_PASS=e2e-viewer-password-123

# Opções do Playwright (e2e/playwright.config.ts) — úteis pra depurar uma
# falha localmente sem editar o arquivo.

# Reporter: list (default), dot, line, html, json...
E2E_REPORTER=list

# Screenshot em falha: off, on, only-on-failure (default), on-first-failure
E2E_SCREENSHOT=only-on-failure

# Gravação de vídeo: off (default), on, retain-on-failure, on-first-retry,
# on-all-retries, retain-on-first-failure, retain-on-failure-and-retries
E2E_VIDEO=off
