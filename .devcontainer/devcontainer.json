{
    "name": "os-camera (isolado do host)",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "features": {
        // dockerd próprio, isolado do host — nada de montar /var/run/docker.sock.
        // scripts/check.sh (frontend/yolo) fala com esse daemon, não com o do host.
        "ghcr.io/devcontainers/features/docker-in-docker:2": {},
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "privileged": true,
    "remoteUser": "vscode",
    "workspaceFolder": "/workspaces/os-camera",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/os-camera,type=bind,consistency=cached",
    "mounts": [
        // credenciais do gh/git persistem entre rebuilds, mas só dentro de um
        // volume Docker isolado — nunca num bind mount do host.
        "source=os-camera-gh-config,target=/home/vscode/.config/gh,type=volume",
        "source=os-camera-go-cache,target=/home/vscode/.cache/go-build,type=volume"
    ],
    "forwardPorts": [8080, 5173],
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.go",
                "dbaeumer.vscode-eslint"
            ]
        }
    }
}
